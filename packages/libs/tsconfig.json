// packages/npm-kit/tsconfig.json

{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Alias */
    "paths": {
      "@/*": ["./src/*"],
      "@env": ["./src/env"],
      "@env/*": ["./src/env/*"],
      "@npm": ["./src/npm"],
      "@npm/*": ["./src/npm/*"],
      "@package": ["./src/package"],
      "@package/*": ["./src/package/*"],
      "@packages": ["./src/_packages"],
      "@packages/*": ["./src/_packages/*"]
    }
  },

  "include": ["_config", "_bin", "src"]
}
