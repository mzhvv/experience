{
  "name": "@mzhvv/libs",
  "version": "0.0.0",
  "type": "module",
  "files": ["dist"],
  "exports": {
    "./*/core": {
      "import": "./dist/*/core/index.js",
      "types": "./dist/*/core/index.d.ts"
    },
    "./*/libs": {
      "import": "./dist/*/libs/index.js",
      "types": "./dist/*/libs/index.d.ts"
    }
  },
  "bin": {
    "mzhvv-libs": "dist/__cli/index.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "ci:build": "npm run clean && npm run build",
    "typecheck": "node _bin/typecheck.js",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:watch": "vitest --watch",
    "coverage": "vitest --coverage",
    "ci:test": "npm run typecheck && npm run test:run",
    "ci": "npm run ci:test && npm run ci:build"
  },
  "dependencies": {
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@types/node": "22.13.4",
    "@vitest/coverage-v8": "3.2.7",
    "glob": "13.0.6",
    "type-fest": "5.9.0",
    "typescript": "5.9.2",
    "vite": "6.4.3",
    "vite-plugin-dts": "4.5.0",
    "vitest": "3.2.7"
  }
}
