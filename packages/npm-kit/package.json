{
  "name": "@mzhvv/npm-kit",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "add-scripts": "dist/bin/add-scripts.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "ci:build": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:watch": "vitest --watch",
    "coverage": "vitest --coverage",
    "ci:test": "npm run typecheck && npm run test:run",
    "ci": "npm run ci:test && npm run ci:build",
    "npm-kit:add-scripts": "node dist/bin/add-scripts.js"
  },
  "dependencies": {
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@types/node": "22.13.4",
    "@vitest/coverage-v8": "3.2.7",
    "typescript": "^5.9.2",
    "vite": "6.4.3",
    "vite-plugin-dts": "4.5.0",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0",
    "vite": "^6.0.0"
  }
}
