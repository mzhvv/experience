{
  "name": "react-17",
  "private": true,
  "version": "0.0.1-dev",
  "type": "module",

  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",

    "test:watch": "jest --watch",
    "types": "npm run types:scss",

    "types:scss": "typed-scss-modules .",
    "format": "npm run stylelint:fix && npm run prettier",
    "prettier": "prettier --write .",
    "stylelint": "stylelint \"src/**/*.{css,scss}\" \"package/**/*.{css,scss}\"",
    "stylelint:fix": "npm run stylelint -- --fix",
    "lint": "eslint .",
    "test": "jest",

    "ci": "npm run types && npm run format && npm run lint && npm run test",
    "dev2": "npm run ci && npm run dev",
    "build2": "npm run ci && npm run build",
    "preview2": "npm run build2 && npm run preview"
  },

  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^1.23.0",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-router-dom": "6.26.1"
  },

  "devDependencies": {
    "@babel/core": "7.24.0",
    "@babel/preset-env": "7.24.0",
    "@babel/preset-react": "7.23.3",
    "@babel/preset-typescript": "7.23.3",
    "@testing-library/jest-dom": "6.4.2",
    "@testing-library/react": "12.1.5",
    "@testing-library/user-event": "14.5.1",
    "@types/jest": "29.5.12",
    "@types/node": "18.19.130",
    "@types/react": "17.0.53",
    "@types/react-dom": "17.0.19",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "@vitejs/plugin-react": "4.3.4",
    "babel-jest": "29.7.0",
    "eslint": "8.57.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-refresh": "0.4.5",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "postcss-scss": "4.0.9",
    "prettier": "3.8.4",
    "sass": "1.77.8",
    "stylelint": "16.26.1",
    "stylelint-config-property-sort-order-smacss": "11.2.0",
    "stylelint-config-standard-scss": "14.0.0",
    "stylelint-order": "6.0.4",
    "typed-scss-modules": "8.1.1",
    "typescript": "4.9.5",
    "vite": "4.5.14"
  }
}
