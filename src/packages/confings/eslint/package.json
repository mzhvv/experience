{
  "name": "@w/eslint-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./base": {
      "types": "./src/base.d.ts",
      "default": "./src/base.js"
    },
    "./next-js": {
      "types": "./src/next.d.ts",
      "default": "./src/next.js"
    },
    "./react-internal": {
      "types": "./src/react-internal.d.ts",
      "default": "./src/react-internal.js"
    }
  },
  "files": ["src"],
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10",
    "@next/eslint-plugin-next": "^16.4.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-turbo": "^2.11.7",
    "globals": "^17.13.0"
  }
}
