{
  "name": "@w/configs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./eslint/*": {
      "types": "./eslint-config/*/index.ts",
      "default": "./eslint-config/*/index.ts"
    },
    "./prettier/*": {
      "types": "./prettier/*/index.ts",
      "default": "./prettier/*/index.ts"
    }
  },
  "files": ["src"]
}
