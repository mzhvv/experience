{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "api": {
      "root": "apps/api",
      "framework": "fastapi",
      "installCommand": "pip install -r requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "api",
        "path": "/:path*"
      }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
