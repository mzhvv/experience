# src/projects/mzhvv/Dockerfile.dev

# --- S1: Зависимости
# Dev-образ содержит все workspace-зависимости приложения.
FROM node:22-alpine

WORKDIR /repo

# Нужна совместимость нативных Node.js-пакетов с Alpine/musl.
RUN apk add --no-cache libc6-compat
# Используем ту же зафиксированную версию pnpm, что и в production.
RUN corepack enable && corepack prepare pnpm@12.16.1 --activate

# Копируем только манифесты, чтобы код не инвалидировал кэш установки зависимостей.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY src/projects/mzhvv/package.json ./src/projects/mzhvv/
COPY src/packages/shadcn-ui/package.json ./src/packages/shadcn-ui/
COPY src/packages/eslint-config/package.json ./src/packages/eslint-config/
COPY src/packages/prettier-config/package.json ./src/packages/prettier-config/
COPY src/packages/typescript-config/package.json ./src/packages/typescript-config/

# Устанавливаем зависимости workspace строго по lock-файлу.
RUN pnpm install --frozen-lockfile

# Исходники копируются один раз; последующие изменения синхронизирует Compose Watch.
COPY src/packages/ ./src/packages/
COPY src/projects/mzhvv ./src/projects/mzhvv

WORKDIR /repo/src/projects/mzhvv

# Принимаем подключения, опубликованные Docker на хосте.
ENV HOSTNAME=0.0.0.0
# Polling позволяет отслеживать изменения файлов с macOS через Docker Desktop.
ENV WATCHPACK_POLLING=true

# Порт dev-сервера; Compose публикует его как localhost:3000.
EXPOSE 3000

# Привязываем Next.js dev-сервер к сетевому интерфейсу контейнера.
CMD ["pnpm", "dev", "--hostname", "0.0.0.0"]