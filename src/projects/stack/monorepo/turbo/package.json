{
  "name": "monorepo",
  "version": "0.0.1",
  "private": true,

  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",

    "web:dev": "npm --workspace=apps/web run dev",
    "fastapi:dev": ". venv/bin/activate && python main.py"
  },

  "devDependencies": {
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "^5"
  },

  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=20.9.0"
  },

  "workspaces": ["src/apps/*", "src/packages/*", "src/apps/*/*"]
}
