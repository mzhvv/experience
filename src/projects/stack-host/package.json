{
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names host,react,react2,vue,angular \"pnpm run dev:server\" \"pnpm run dev:react\" \"pnpm run dev:react:stub2\" \"pnpm run dev:vue\" \"pnpm run dev:angular\"",
    "build": "pnpm run build:server && pnpm run build:react && pnpm run build:react:stub2 && pnpm run build:vue && pnpm run build:angular",
    "start": "concurrently --kill-others-on-fail --names host,react,react2,vue,angular \"pnpm run start:server\" \"pnpm run start:react\" \"pnpm run start:react:stub2\" \"pnpm run start:vue\" \"pnpm run start:angular\"",
    "start:docker": "concurrently --kill-others-on-fail --names host,react,react2,vue,angular \"pnpm run start:server\" \"pnpm run start:react\" \"pnpm run start:react:stub2\" \"pnpm run start:vue\" \"pnpm run start:angular:static\"",

    "dev:server": "NEXT_PUBLIC_REACT_APP_URL=http://localhost:5173 NEXT_PUBLIC_REACT_STUB2_APP_URL=http://localhost:5176 NEXT_PUBLIC_VUE_APP_URL=http://localhost:5174 NEXT_PUBLIC_ANGULAR_APP_URL=http://localhost:5175 next dev --hostname 0.0.0.0 --port 3001",
    "build:server": "NEXT_PUBLIC_REACT_APP_URL=http://localhost:5173 NEXT_PUBLIC_REACT_STUB2_APP_URL=http://localhost:5176 NEXT_PUBLIC_VUE_APP_URL=http://localhost:5174 NEXT_PUBLIC_ANGULAR_APP_URL=http://localhost:5175 next build",
    "start:server": "NEXT_PUBLIC_REACT_APP_URL=http://localhost:5173 NEXT_PUBLIC_REACT_STUB2_APP_URL=http://localhost:5176 NEXT_PUBLIC_VUE_APP_URL=http://localhost:5174 NEXT_PUBLIC_ANGULAR_APP_URL=http://localhost:5175 next start --hostname 0.0.0.0 --port 3001",

    "dev:react": "pnpm --filter stack-react-stub run dev --host 0.0.0.0 --port 5173 --strictPort",
    "build:react": "pnpm --filter stack-react-stub run build",
    "start:react": "pnpm --filter stack-react-stub run start --host 0.0.0.0 --port 5173 --strictPort",
    "dev:react:stub2": "pnpm --filter stack-react-stub2 run dev --host 0.0.0.0 --port 5176 --strictPort",
    "build:react:stub2": "pnpm --filter stack-react-stub2 run build",
    "start:react:stub2": "pnpm --filter stack-react-stub2 run start --host 0.0.0.0 --port 5176 --strictPort",
    "dev:vue": "pnpm --filter stack-vue-stub run dev --host 0.0.0.0 --port 5174 --strictPort",
    "build:vue": "pnpm --filter stack-vue-stub run build",
    "start:vue": "pnpm --filter stack-vue-stub run start --host 0.0.0.0 --port 5174 --strictPort",
    "dev:angular": "pnpm --filter stack-angular-stub run dev --host 0.0.0.0 --port 5175",
    "build:angular": "pnpm --filter stack-angular-stub run build",
    "start:angular": "pnpm --filter stack-angular-stub run start --host 0.0.0.0 --port 5175",
    "start:angular:static": "node scripts/serve-static.mjs ../stack/angular/stub/dist/angular/browser 5175",
    "typecheck": "tsc --noEmit"
  },

  "name": "stack-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@workspace/shadcn-ui": "workspace:*",
    "@workspace/ui-react": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "concurrently": "^9.2.5",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/prettier-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
