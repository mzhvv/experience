{
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names host,react-19,vue-3,angular-22 \"pnpm run dev:server\" \"pnpm run dev:react-19\" \"pnpm run dev:vue-3\" \"pnpm run dev:angular-22\"",
    "build": "pnpm run build:server && pnpm run build:react-19 && pnpm run build:vue-3 && pnpm run build:angular-22",
    "start": "concurrently --kill-others-on-fail --names host,react-19,vue-3,angular-22 \"pnpm run start:server\" \"pnpm run start:react-19\" \"pnpm run start:vue-3\" \"pnpm run start:angular-22\"",
    "start:docker": "concurrently --kill-others-on-fail --names host,react-19,vue-3,angular-22 \"pnpm run start:server\" \"pnpm run start:react-19\" \"pnpm run start:vue-3\" \"pnpm run start:angular-22:static\"",

    "dev:server": "NEXT_PUBLIC_REACT_APP_URL=http://localhost:5173  NEXT_PUBLIC_VUE_APP_URL=http://localhost:5174 NEXT_PUBLIC_ANGULAR_APP_URL=http://localhost:5175 next dev --hostname 0.0.0.0 --port 3001",
    "build:server": "NEXT_PUBLIC_REACT_APP_URL=http://localhost:5173  NEXT_PUBLIC_VUE_APP_URL=http://localhost:5174 NEXT_PUBLIC_ANGULAR_APP_URL=http://localhost:5175 next build",
    "start:server": "NEXT_PUBLIC_REACT_APP_URL=http://localhost:5173  NEXT_PUBLIC_VUE_APP_URL=http://localhost:5174 NEXT_PUBLIC_ANGULAR_APP_URL=http://localhost:5175 next start --hostname 0.0.0.0 --port 3001",

    "dev:react-19": "pnpm --filter stack-react-19 run dev --host 0.0.0.0 --port 5173 --strictPort",
    "build:react-19": "pnpm --filter stack-react-19 run build",
    "start:react-19": "pnpm --filter stack-react-19 run start --host 0.0.0.0 --port 5173 --strictPort",

    "dev:vue-3": "pnpm --filter stack-vue-3 run dev --host 0.0.0.0 --port 5174 --strictPort",
    "build:vue-3": "pnpm --filter stack-vue-3 run build",
    "start:vue-3": "pnpm --filter stack-vue-3 run start --host 0.0.0.0 --port 5174 --strictPort",

    "dev:angular-22": "pnpm --filter stack-angular-22 run dev --host 0.0.0.0 --port 5175",
    "build:angular-22": "pnpm --filter stack-angular-22 run build",
    "start:angular-22": "pnpm --filter stack-angular-22 run start --host 0.0.0.0 --port 5175",
    "start:angular-22:static": "node scripts/serve-static.mjs ../stack/angular-22/dist/angular/browser 5175",

    "typecheck": "tsc --noEmit"
  },

  "name": "experience",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@workspace/experience-routes": "workspace:*",
    "@workspace/shadcn-ui": "workspace:*",
    "@workspace/ui-react": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "concurrently": "^9.2.5",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/prettier-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
